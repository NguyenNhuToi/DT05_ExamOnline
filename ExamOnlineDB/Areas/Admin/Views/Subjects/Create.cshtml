@model ExamOnlineDB.ViewModels.SubjectCreateEditViewModel
@{
    ViewData["Title"] = "Thêm Môn học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Thêm Môn học mới</h2>
    <form asp-action="Create" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="SubjectCode" class="form-label">Mã Môn học</label>
            <input asp-for="SubjectCode" class="form-control" placeholder="VD: 11CN16" />
            <span asp-validation-for="SubjectCode" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SubjectName" class="form-label">Tên Môn học</label>
            <input asp-for="SubjectName" class="form-control" placeholder="VD: Công nghệ phần mềm" />
            <span asp-validation-for="SubjectName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Kích hoạt</label>
        </div>
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
    </form>
</div>