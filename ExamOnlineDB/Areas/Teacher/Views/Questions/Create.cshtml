@{
    ViewData["Title"] = "Thêm câu hỏi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var topics = ViewBag.Topics as List<ExamOnlineDB.Models.Topic> ?? new();
}
<h2>Thêm câu hỏi</h2>
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Chủ đề</label>
        <select name="TopicId" class="form-select">
            @foreach (var t in topics)
            {
                <option value="@t.TopicId">@t.TopicName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Nội dung câu hỏi</label>
        <textarea name="Content" class="form-control" rows="3" required></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Mức độ</label>
        <select name="DifficultyLevel" class="form-select">
            <option value="1">Dễ</option>
            <option value="2">Trung bình</option>
            <option value="3">Khó</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Đáp án (chọn radio cho đáp án đúng)</label>
        @for (int i = 0; i < 4; i++)
        {
            <div class="input-group mb-2">
                <div class="input-group-text">
                    <input type="radio" name="correctIndex" value="@i" @(i == 0 ? "checked" : "") />
                </div>
                <input type="text" name="optionContent" class="form-control" placeholder="Đáp án @(i + 1)" />
            </div>
        }
    </div>
    <button class="btn btn-primary" type="submit">Lưu</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>