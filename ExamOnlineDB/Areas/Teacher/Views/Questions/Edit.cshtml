@model ExamOnlineDB.Models.Question
@{
    ViewData["Title"] = "Sửa câu hỏi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var topics = ViewBag.Topics as List<ExamOnlineDB.Models.Topic> ?? new();
    var opts = Model.Options.ToList();
    var correct = opts.FindIndex(o => o.IsCorrect);
}
<h2>Sửa câu hỏi #@Model.QuestionId</h2>
<form asp-action="Edit" asp-route-id="@Model.QuestionId" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Chủ đề</label>
        <select name="TopicId" class="form-select">
            @foreach (var t in topics)
            {
                <option value="@t.TopicId" selected="@(t.TopicId == Model.TopicId)">@t.TopicName</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Nội dung</label>
        <textarea name="Content" class="form-control" rows="3" required>@Model.Content</textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Mức độ</label>
        <select name="DifficultyLevel" class="form-select">
            <option value="1" selected="@(Model.DifficultyLevel == 1)">Dễ</option>
            <option value="2" selected="@(Model.DifficultyLevel == 2)">Trung bình</option>
            <option value="3" selected="@(Model.DifficultyLevel == 3)">Khó</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Đáp án</label>
        @for (int i = 0; i < 4; i++)
        {
            var val = i < opts.Count ? opts[i].Content : "";
            <div class="input-group mb-2">
                <div class="input-group-text">
                    <input type="radio" name="correctIndex" value="@i" @(i == correct ? "checked" : "") />
                </div>
                <input type="text" name="optionContent" class="form-control" value="@val" />
            </div>
        }
    </div>
    <button class="btn btn-primary" type="submit">Cập nhật</button>
    <a class="btn btn-secondary" asp-action="Index">Hủy</a>
</form>