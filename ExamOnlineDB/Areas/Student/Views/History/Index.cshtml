@model List<UserExam>
@{
    ViewData["Title"] = "Lịch sử thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Lịch sử bài thi của tôi</h2>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">Bạn chưa hoàn thành bài thi nào.</div>
    }
    else
    {
        <div class="card shadow-sm mt-3">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã Kỳ Thi</th>
                            <th>Tên Kỳ Thi</th>
                            <th>Môn Học</th>
                            <th class="text-center">Điểm Số</th>
                            <th>Thời Gian Nộp</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center">Thao Tác</th> <!-- Thêm cột này -->
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Exam?.ExamCode</td>
                                <td>@item.Exam?.ExamTitle</td>
                                <td>@item.Exam?.Subject?.SubjectName</td>
                                <td class="text-center fw-bold text-danger">@item.TotalScore</td>
                                <td>@item.SubmittedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <span class="badge bg-success">Đã nộp</span>
                                </td>
                                <td class="text-center">
                                    <!-- Nút Xem chi tiết -->
                                    <a asp-area="Student" asp-controller="TakeExam" asp-action="Review"
                                       asp-route-userExamId="@item.UserExamId"
                                       class="btn btn-sm btn-info text-white">
                                        🔍 Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>