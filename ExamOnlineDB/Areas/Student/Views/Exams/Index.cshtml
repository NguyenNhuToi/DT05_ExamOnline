@model StudentExamListViewModel
@{
    ViewData["Title"] = "Kỳ thi của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var studentId = (int)(ViewBag.StudentId ?? 0);
}
<h2>Danh sách kỳ thi</h2>
@if (!Model.Exams.Any())
{
    <div class="alert alert-info">Bạn chưa được phân công kỳ thi nào.</div>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Mã</th><th>Tên kỳ thi</th><th>Môn</th><th>Thời lượng</th><th>Trạng thái</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in Model.Exams)
            {
                var done = Model.CompletedExamIds.Contains(e.ExamId);
                <tr>
                    <td>@e.ExamCode</td>
                    <td>@e.ExamTitle</td>
                    <td>@e.Subject?.SubjectName</td>
                    <td>@e.DurationMinutes phút</td>
                    <td>@(done ? "Đã nộp" : "Chưa làm")</td>
                    <td>
                        @if (!done)
                        {
                            <a class="btn btn-sm btn-primary"
                               asp-area="Student" asp-controller="TakeExam" asp-action="Index"
                               asp-route-examId="@e.ExamId">Vào thi</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}