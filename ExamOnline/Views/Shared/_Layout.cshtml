<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExamOnline</title>
    <!-- Nhúng Bootstrap 5 và Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-journal-check"></i> ExamOnline</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <!-- MENU BÊN TRÁI -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            // Chỉ Admin và Giảng viên mới thấy menu Quản lý
                            @if (User.IsInRole("Admin") || User.IsInRole("GiangVien"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="MonHoc" asp-action="Index"><i class="bi bi-book"></i> Môn học</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="CauHoi" asp-action="Index"><i class="bi bi-question-circle"></i> Câu hỏi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-controller="MaTranDe" asp-action="Index"><i class="bi bi-grid-3x3-gap"></i> Ma trận đề</a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- MENU BÊN PHẢI (ĐĂNG NHẬP/ĐĂNG XUẤT) -->
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-warning fw-bold"><i class="bi bi-person-circle"></i> @User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                    <button type="submit" class="nav-link btn btn-link text-white"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus"></i> Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- NỘI DUNG CHÍNH CỦA CÁC TRANG -->
    <div class="container mt-4" style="min-height: 80vh;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-top footer text-muted text-center py-3 bg-light mt-auto">
        <div class="container">
            &copy; 2026 - Nhóm 5 - DT05 ExamOnline
        </div>
    </footer>

    <!-- NHÚNG JAVASCRIPT CỦA BOOTSTRAP -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>