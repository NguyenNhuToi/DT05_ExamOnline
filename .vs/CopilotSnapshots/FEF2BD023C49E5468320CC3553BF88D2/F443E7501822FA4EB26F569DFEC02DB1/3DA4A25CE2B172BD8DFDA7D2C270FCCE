@model AssignStudentsViewModel
@{
    ViewData["Title"] = "Phân công Sinh viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Phân công Sinh viên cho: @Model.ExamTitle</h2>
    <form asp-action="Assign" method="post" class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="examId" value="@Model.ExamId" />
        
        <div class="mb-3">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll()">Chọn tất cả / Bỏ chọn</button>
        </div>

        <table class="table table-hover table-striped">
            <thead>
                <tr>
                    <th style="width: 50px;">Chọn</th>
                    <th>Mã SV</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="checkbox" name="selectedStudentIds" value="@Model.Students[i].UserId"
                                   class="form-check-input student-checkbox" @(Model.Students[i].IsSelected ? "checked" : "") />
                        </td>
                        <td>@Model.Students[i].UserCode</td>
                        <td>@Model.Students[i].FullName</td>
                        <td>@Model.Students[i].Email</td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Lưu Phân công</button>
        <a asp-action="Details" asp-route-id="@Model.ExamId" class="btn btn-secondary">Hủy</a>
    </form>
</div>

@section Scripts {
    <script>
        function toggleAll() {
            var checkboxes = document.querySelectorAll('.student-checkbox');
            var allChecked = Array.from(checkboxes).every(cb => cb.checked);
            checkboxes.forEach(cb => cb.checked = !allChecked);
        }
    </script>
}