@model ExamDetailViewModel
@{
    ViewData["Title"] = "Chi tiết Kỳ thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Chi tiết Kỳ thi: @Model.Exam.ExamTitle</h2>
        <div>
            <a class="btn btn-outline-primary" asp-action="Assign" asp-route-id="@Model.Exam.ExamId">Phân công sinh viên</a>
            <a class="btn btn-secondary" asp-action="Index">Quay lại</a>
        </div>
    </div>

    <ul class="nav nav-tabs" id="examTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button">Thông tin</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="participants-tab" data-bs-toggle="tab" data-bs-target="#participants" type="button">Sinh viên dự thi (@Model.Participants.Count)</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="results-tab" data-bs-toggle="tab" data-bs-target="#results" type="button">Kết quả (@Model.Results.Count)</button>
        </li>
    </ul>

    <div class="tab-content p-3 border border-top-0" id="examTabsContent">
        <div class="tab-pane fade show active" id="info" role="tabpanel">
            <p><strong>Mã kỳ thi:</strong> @Model.Exam.ExamCode</p>
            <p><strong>Môn học:</strong> @Model.Exam.Subject?.SubjectName</p>
            <p><strong>Ma trận:</strong> @Model.Exam.Matrix?.MatrixName</p>
            <p><strong>Thời lượng:</strong> @Model.Exam.DurationMinutes phút</p>
            <p><strong>Thời gian:</strong> @Model.Exam.StartTime.ToString("dd/MM/yyyy HH:mm") - @Model.Exam.EndTime.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div class="tab-pane fade" id="participants" role="tabpanel">
            <table class="table table-striped">
                <thead><tr><th>Mã SV</th><th>Họ tên</th><th>Email</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.Participants)
                    {
                        <tr>
                            <td>@p.Student?.UserCode</td>
                            <td>@p.Student?.FullName</td>
                            <td>@p.Student?.Email</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="tab-pane fade" id="results" role="tabpanel">
            <table class="table table-striped">
                <thead><tr><th>Mã SV</th><th>Họ tên</th><th>Điểm</th><th>Thời gian nộp</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Results)
                    {
                        <tr>
                            <td>@r.Student?.UserCode</td>
                            <td>@r.Student?.FullName</td>
                            <td class="fw-bold text-danger">@r.TotalScore</td>
                            <td>@r.SubmittedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Kích hoạt Bootstrap tabs
        var triggerTabList = [].slice.call(document.querySelectorAll('#examTabs button'))
        triggerTabList.forEach(function (triggerEl) {
            new bootstrap.Tab(triggerEl)
        })
    </script>
}