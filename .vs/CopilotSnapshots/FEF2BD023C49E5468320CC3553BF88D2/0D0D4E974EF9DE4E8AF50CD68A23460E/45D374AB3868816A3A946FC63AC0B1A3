@model TakeExamViewModel
@{
    ViewData["Title"] = "Làm bài thi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@Model.Exam.ExamTitle</h3>
    <div class="alert alert-warning mb-0">
        <b>Thời gian còn lại: <span id="countdown">--:--</span></b>
    </div>
</div>
<form id="examForm">
    @foreach (var q in Model.Questions)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span>Câu @q.QuestionOrder (Mức @q.Question?.DifficultyLevel)</span>
                <span class="badge bg-secondary" id="status-@q.UserExamQuestionId">Chưa trả lời</span>
            </div>
            <div class="card-body">
                <p><strong>@q.Question?.Content</strong></p>
                @foreach (var o in q.Options.OrderBy(o => o.DisplayOrder))
                {
                    <div class="form-check">
                        <input class="form-check-input answer-radio" type="radio"
                               name="q_@q.UserExamQuestionId" value="@o.UserExamOptionId"
                               data-qid="@q.UserExamQuestionId"
                               id="o_@o.UserExamOptionId"
                        @(q.SelectedUserExamOptionId == o.UserExamOptionId ? "checked" : "") />
                        <label class="form-check-label" for="o_@o.UserExamOptionId">
                            <b>@o.DisplayLabel.</b> @o.OriginalOption?.Content
                        </label>
                    </div>
                }
            </div>
        </div>
    }
    <button type="button" id="btnSubmit" class="btn btn-success btn-lg mt-3">Nộp bài</button>
</form>

@section Scripts {
    <script src="~/js/exam-timer.js"></script>
    <script>
        const endTime = new Date('@Model.EndTime.ToString("yyyy-MM-ddTHH:mm:ss")').getTime();
        const userExamId = @Model.UserExam.UserExamId;
        
        // 1. Khởi động đồng hồ đếm ngược (gọi từ file exam-timer.js)
        startCountdown(endTime, userExamId);

        // 2. Đánh dấu các câu đã trả lời khi load trang (nếu có lưu trước đó)
        document.querySelectorAll('.answer-radio:checked').forEach(function (radio) {
            const qid = radio.dataset.qid;
            const status = document.getElementById('status-' + qid);
            status.className = 'badge bg-success';
            status.textContent = 'Đã trả lời';
        });

        // 3. Tự động lưu đáp án khi click (AJAX)
        document.querySelectorAll('.answer-radio').forEach(function (radio) {
            radio.addEventListener('change', function () {
                const qid = radio.dataset.qid;
                const oid = radio.value;
                fetch('/Student/TakeExam/SaveAnswer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ userExamQuestionId: qid, selectedOptionId: oid })
                }).then(function (response) { return response.json(); }).then(function (res) {
                    if (res.success) {
                        const status = document.getElementById('status-' + qid);
                        status.className = 'badge bg-success';
                        status.textContent = 'Đã trả lời';
                    }
                });
            });
        });

        // 4. Xử lý sự kiện bấm nút Nộp bài
        document.getElementById('btnSubmit').addEventListener('click', function () {
            if (!confirm('Bạn chắc chắn muốn nộp bài? Không thể sửa lại sau khi nộp.')) return;

            fetch('/Student/TakeExam/Submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ userExamId: userExamId })
            }).then(function (response) { return response.json(); }).then(function (res) {
                if (res.success) {
                    alert('Nộp bài thành công!');
                    window.location.href = res.redirectUrl;
                } else {
                    alert('Có lỗi xảy ra khi nộp bài. Vui lòng thử lại.');
                }
            });
        });
    </script>
}