using ExamOnlineDB.Data;
using ExamOnlineDB.Models;
using ExamOnlineDB.ViewModels;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Rendering;
using Microsoft.EntityFrameworkCore;

namespace ExamOnlineDB.Areas.Teacher.Controllers;

[Area("Teacher")]
public class ExamsController : Controller
{
    private readonly ExamOnlineDBContext _db;

    private bool IsTeacher() => HttpContext.Session.GetString("RoleName") == "Teacher";
    public ExamsController(ExamOnlineDBContext db) => _db = db;

    // GET: /Teacher/Exams
    public async Task<IActionProvider> Index()
    {
        if (!IsTeacher())
            return RedirectToAction("Login", "Account", new { area = "" });
        var exams = await _db.Exams
            .Include(e => e.Subject)
            .Include(e => e.Matrix)
            .OrderByDescending(e => e.CreatedAt)
            .ToListAsync();
        return View(new ExamListViewModel { Exams = exams });
    }

    // GET: /Teacher/Exams/Create
    public async Task<IActionResult> Create()
    {
        ViewBag.Subjects = new SelectList(await _db.Subjects.ToListAsync(), "SubjectId", "SubjectName");
        ViewBag.Matrices = new SelectList(await _db.ExamMatrices.ToListAsync(), "MatrixId", "MatrixName");
        return View(new CreateExamViewModel());
    }

    // POST: /Teacher/Exams/Create
    [HttpPost]
    [ValidateAntiForgeryToken]
    public async Task<IActionResult> Create(CreateExamViewModel model)
    {
        if (model.EndTime <= model.StartTime)
            ModelState.AddModelError("EndTime", "Thời gian kết thúc phải sau thời gian bắt đầu.");

        if (ModelState.IsValid)
        {
            var creatorId = HttpContext.Session.GetInt32("UserId");
            if (creatorId is null)
                return RedirectToAction("Login", "Account", new { area = "" });

            // Tạo mã kỳ thi tự động
            var examCode = $"EXAM_{DateTime.Now:yyyyMMddHHmmss}";

            var exam = new Exam
            {
                ExamCode = examCode,
                ExamTitle = model.ExamTitle,
                SubjectId = model.SubjectId,
                MatrixId = model.MatrixId,
                DurationMinutes = model.DurationMinutes,
                StartTime = model.StartTime,
                EndTime = model.EndTime,
                ShuffleQuestions = model.ShuffleQuestions,
                ShuffleOptions = model.ShuffleOptions,
                Status = 0, // 0 = Nháp
                CreatedBy = creatorId.Value,
                CreatedAt = DateTime.Now
            };
            _db.Exams.Add(exam);
            await _db.SaveChangesAsync();
            TempData["Success"] = "Tạo kỳ thi thành công!";
            return RedirectToAction(nameof(Index));
        }

        ViewBag.Subjects = new SelectList(await _db.Subjects.ToListAsync(), "SubjectId", "SubjectName");
        ViewBag.Matrices = new SelectList(await _db.ExamMatrices.ToListAsync(), "MatrixId", "MatrixName");
        return View(model);
    }

    // POST: /Teacher/Exams/ToggleStatus/5
    [HttpPost]
    [ValidateAntiForgeryToken]
    public async Task<IActionResult> ToggleStatus(int id)
    {
        var exam = await _db.Exams.FindAsync(id);
        if (exam == null) return NotFound();

        // Đảo trạng thái: Nháp (0) -> Đang mở (1) -> Đã đóng (2) -> Đang mở (1)
        exam.Status = exam.Status == 1 ? (byte)2 : (byte)1;
        await _db.SaveChangesAsync();
        TempData["Success"] = exam.Status == 1 ? "Đã mở kỳ thi." : "Đã đóng kỳ thi.";
        return RedirectToAction(nameof(Index));
    }

    // GET: /Teacher/Exams/Details/5
    public async Task<IActionResult> Details(int id)
    {
        var exam = await _db.Exams
            .Include(e => e.Subject)
            .Include(e => e.Matrix)
            .FirstOrDefaultAsync(e => e.ExamId == id);
        if (exam == null) return NotFound();

        var participants = await _db.ExamParticipants
            .Include(p => p.Student)
            .Where(p => p.ExamId == id)
            .ToListAsync();

        // Kết quả thi: những sinh viên đã nộp bài
        var results = await _db.UserExams
            .Include(u => u.Student)
            .Where(u => u.ExamId == id && u.Status == 2)
            .OrderByDescending(u => u.TotalScore)
            .ToListAsync();

        return View(new ExamDetailViewModel
        {
            Exam = exam,
            Participants = participants,
            Results = results
        });
    }

    // GET: /Teacher/Exams/Assign/5
    public async Task<IActionResult> Assign(int id)
    {
        var exam = await _db.Exams.FindAsync(id);
        if (exam == null) return NotFound();

        // Lấy tất cả sinh viên (Role = Student)
        var students = await _db.Users
            .Where(u => u.IsActive)
            .ToListAsync();

        // Lấy danh sách đã được phân công
        var assignedIds = await _db.ExamParticipants
            .Where(p => p.ExamId == id)
            .Select(p => p.StudentId)
            .ToListAsync();

        // Lọc chỉ lấy User có Role là Student
        var studentRole = await _db.Roles.FirstOrDefaultAsync(r => r.RoleName == "Student");

        var selection = students
            .Where(s => studentRole != null && s.RoleId == studentRole.RoleId)
            .Select(s => new StudentSelection
            {
                UserId = s.UserId,
                UserCode = s.UserCode ?? "",
                FullName = s.FullName,
                Email = s.Email ?? "",
                IsSelected = assignedIds.Contains(s.UserId)
            }).ToList();

        return View(new AssignStudentsViewModel
        {
            ExamId = id,
            ExamTitle = exam.ExamTitle,
            Students = selection
        });
    }

    // POST: /Teacher/Exams/Assign
    [HttpPost]
    [ValidateAntiForgeryToken]
    public async Task<IActionResult> Assign(int examId, List<int> selectedStudentIds)
    {
        // Xóa các phân công cũ
        var oldAssigns = _db.ExamParticipants.Where(p => p.ExamId == examId);
        _db.ExamParticipants.RemoveRange(oldAssigns);

        // Thêm phân công mới
        if (selectedStudentIds != null && selectedStudentIds.Any())
        {
            foreach (var sid in selectedStudentIds)
            {
                _db.ExamParticipants.Add(new ExamParticipant
                {
                    ExamId = examId,
                    StudentId = sid,
                    IsEligible = true
                });
            }
        }

        await _db.SaveChangesAsync();
        TempData["Success"] = $"Đã phân công {selectedStudentIds?.Count ?? 0} sinh viên.";
        return RedirectToAction(nameof(Details), new { id = examId });
    }
}